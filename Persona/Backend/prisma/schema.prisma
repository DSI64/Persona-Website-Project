// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Persona {
  id          String   @id
  name        String
  arcana      String
  originGame  String
  description String
  images      String[]
  affinities  Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([arcana])
  @@index([originGame])
  @@map("personas")
}

model Character {
  id           Int      @id
  name         String
  game         String
  arcana       String
  image        String
  title        String
  birthday     String
  appearances  String
  personas     String
  voiceActors  String
  likes        String
  dislikes     String
  profile      String
  images       String[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([game])
  @@index([arcana])
  @@map("characters")
}

model SocialLink {
  id           String   @id
  name         String
  game         String
  arcana       String
  title        String
  image        String
  bio          String
  availability String
  requirements String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([game])
  @@index([arcana])
  @@map("social_links")
}

model Track {
  id         Int      @id
  title      String
  game       String
  category   String
  artist     String
  duration   String?
  themeClass String
  embedId    String
  boxArt     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([title])
  @@index([game])
  @@index([category])
  @@index([artist])
  @@map("tracks")
}